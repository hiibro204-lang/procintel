# ---------------------------------------------------------------------------
# Copy to .env and adjust. NEVER commit .env — it is gitignored.
# ---------------------------------------------------------------------------

# Database. SQLite for local work, PostgreSQL for anything shared.
DATABASE_URL=sqlite:///./procintel.db
# DATABASE_URL=postgresql+psycopg://procintel:procintel@localhost:5432/procintel

# Where archived artefacts (HTML, PDF, XLS) are stored. Content-addressed.
ARCHIVE_DIR=./archive

# ---------------------------------------------------------------------------
# LLM. You do NOT need to set this here: open /settings in the UI and paste the
# key there. It is validated, encrypted at rest and used immediately. Setting it
# here only seeds a default that the settings screen can override or clear.
# Get a key at https://openrouter.ai/keys
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=

# Encryption key for secrets stored through the UI. If unset, one is generated
# into .secret.key (0600, gitignored). Set it explicitly in production, and
# rotate it deliberately: rotating invalidates previously stored secrets.
APP_SECRET_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Cheap tier for bulk document extraction:
EXTRACTION_MODEL=google/gemini-2.0-flash-001
# Stronger tier for the assistant's phrasing pass:
ASSISTANT_MODEL=anthropic/claude-3.5-haiku

# ---------------------------------------------------------------------------
# Collection policy
# ---------------------------------------------------------------------------
CRAWLER_USER_AGENT=InfiSourceProcurementBot/0.1 (+contact: procurement-ops@infisource.example)
CRAWLER_MAX_RPM=20
POLICY_MAX_AGE_DAYS=365

# Statistical reporting floors — see blueprint Section 10.3
MIN_N_FOR_STATS=3
MIN_N_FOR_DISTRIBUTION=8

# Tenancy (Phase 9). Leave off for internal single-tenant use.
AUTH_ENABLED=false
DEFAULT_TENANT_SLUG=infisource
